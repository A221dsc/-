{
  "spec_version": "2.0",
  "purpose": "public-dataset benchmark and scenario-conditioned regional index selection",
  "datasets": ["TDRIVE_REAL", "PORTO_REAL", "MOVING_AI_SEMI_SYNTH", "OSM_SCALED_STRESS"],
  "indexes": ["UNIFORM_GRID", "PR_QUADTREE", "RSTAR_BOOST", "RSTAR_LIBSPATIALINDEX", "GE_TREE_REPRO", "OUR_SCENARIO_RL"],
  "region_policies": ["ALL_SCAN", "ALL_FINE", "ALL_QUAD", "THRESHOLD", "GREEDY_COST", "RL_HISTORY", "RL_SCENARIO", "OFFLINE_ORACLE"],
  "region_grid": [16, 16],
  "local_mode_actions": ["SCAN", "FINE_GRID", "LOCAL_QUAD"],
  "decision_interval_steps": 50,
  "nominal_lookahead_steps": 200,
  "phase_count": 4,
  "phase_length_steps": 600,
  "query_types_main": {"RECT": 0.25, "CIRCLE": 0.20, "SECTOR": 0.35, "SEGMENT_INTERSECT": 0.20},
  "query_types_separate": ["KNN"],
  "scaled_entity_counts": [20000, 50000, 200000, 500000, 1000000],
  "primary_scaled_entity_count": 200000,
  "queries_per_step_scaled_main": 1000,
  "update_active_fractions": [0.1, 0.5, 1.0],
  "test_random_seeds": [101, 203, 307, 409, 503],
  "exact_result_equality_required": true,
  "report_absolute_wall_time": true,
  "report_query_update_build_switch_policy_components": true,
  "real_trace_rule": "retain original timestamps; never label interpolated as original",
  "data_leakage_rule": "online policy cannot access true future positions, queries, or test perturbation seeds"
}
